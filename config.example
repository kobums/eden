# terminal-dev 설정 예시
# 이 파일을 ~/.config/terminal-dev/config 로 복사해서 사용하세요.
# 설정이 없어도 기본값으로 완결된 경험을 줍니다 (모든 줄은 선택 사항).

# 컬러 프리셋 (theme 을 먼저 두고, 아래에서 개별 색으로 덮어쓸 수 있음)
#   catppuccin (기본) | guezwhoz (iTerm2 다크 프리셋)
# theme = guezwhoz

# 폰트 크기 (논리 픽셀, 6~72)
# font-size = 14

# 폰트 파일 경로 (없으면 시스템 고정폭 폰트 자동 선택)
# font-path = /System/Library/Fonts/Menlo.ttc

# 스크롤백 줄 수
# scrollback = 10000

# 커서 모양: block(기본) | bar | underline  (iTerm2 Cursor Type과 대응)
# cursor-style = block

# 배경 불투명도 0.2~1.0 (1.0 = 불투명). iTerm2처럼 기본 배경에만 적용되고
# 셀 배경색·텍스트는 불투명을 유지합니다.
# background-opacity = 0.9

# 색상 (#rrggbb)
# background = #16161e
# foreground = #d9d9de
# cursor-color = #d9d9de
# selection-color = #3b547a

# 16색 ANSI 팔레트 (palette-0 ~ palette-15)
# palette-0 = #333333
# palette-1 = #e85181
# ...
# palette-15 = #ededed
